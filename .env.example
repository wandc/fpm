# Copy to .env and edit. Never commit .env.
COMPOSE_PROJECT_NAME=fpm
POSTGRES_DB=fpm_db
POSTGRES_USER=appuser
# Choose your own long random password, e.g. `openssl rand -hex 24`
POSTGRES_PASSWORD=change-me
TZ=UTC

# Where the app listens. 127.0.0.1 = this computer only. Use 0.0.0.0 to reach it from other computers.
BIND_ADDR=127.0.0.1
APP_PORT=48731

# DEMO LOGIN (user name + password on the sign-in page). On by default so a new install can be tried at once.
# Sign in with demo / demo. Set DEMO_LOGIN_ENABLED=false (or change the password) before anyone else can reach the app.
DEMO_LOGIN_ENABLED=true
DEMO_LOGIN_USER=demo
DEMO_LOGIN_PASS=demo

# Real sign-in: Google OAuth (see OAUTH2_SETUP.md in the repository). Needs the public address of the app.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# With BLOCK_NEW_ACCOUNTS=true only these e-mail addresses (comma separated) can sign in with Google.
BLOCK_NEW_ACCOUNTS=true
ALLOWED_EMAILS=
APP_OAUTH_CALLBACK_URL=http://localhost:48731/index.php?page=oauth2_callback

# Optional emergency link-based login for administrators: set DEV_LOGIN_ENABLED=true and a long random secret, then open
#   http://localhost:48731/index.php?page=login&dev_login=<DEV_LOGIN_SECRET>
DEV_LOGIN_ENABLED=false
DEV_LOGIN_SECRET=

# 32 random bytes in hex, e.g. `openssl rand -hex 32`
CREDENTIALS_ENCRYPTION_KEY=
